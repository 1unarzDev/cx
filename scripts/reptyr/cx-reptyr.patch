diff -ruN a/platform/linux/linux_ptrace.c b/platform/linux/linux_ptrace.c
--- a/platform/linux/linux_ptrace.c	2026-10-19 21:01:55.945559204 -0500
+++ b/platform/linux/linux_ptrace.c	2026-10-19 21:14:08.414040552 -0500
@@ -111,10 +111,26 @@
 int ptrace_attach_child(struct ptrace_child *child, pid_t pid) {
     memset(child, 0, sizeof * child);
     child->pid = pid;
-    if (ptrace_command(child, PTRACE_ATTACH) < 0)
+    // cx: PTRACE_ATTACH queues a SIGSTOP that the SIGCONT in
+    // ptrace_finish_attach can discard before the tracee takes it, leaving
+    // waitpid() blocked forever on busy multithreaded targets. A seized
+    // tracee's PTRACE_INTERRUPT stop cannot be cancelled by SIGCONT.
+    if (ptrace_command(child, PTRACE_SEIZE, 0, 0) < 0)
         return -1;
+    if (ptrace_command(child, PTRACE_INTERRUPT, 0, 0) < 0)
+        goto detach;
+    if (ptrace_wait(child) < 0)
+        goto detach;
+    if (arch_get_personality(child))
+        goto detach;
+    if (ptrace_command(child, PTRACE_SETOPTIONS, 0,
+                       PTRACE_O_TRACESYSGOOD | PTRACE_O_TRACEFORK) < 0)
+        goto detach;
+    return 0;
 
-    return ptrace_finish_attach(child, pid);
+detach:
+    ptrace(PTRACE_DETACH, child->pid, 0, 0);
+    return -1;
 }
 
 int ptrace_finish_attach(struct ptrace_child *child, pid_t pid) {
